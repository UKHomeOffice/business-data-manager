    "crc-32": "^1.2.2",
    "errorhandler": "^1.5.1",
    "express": "^4.21.0",
    "express-flash": "0.0.2",
    "express-session": "^1.17.2",
    "express-validator": "^6.14.0",
    "govuk-frontend": "^4.4.0",
    "lodash": "^4.17.23",
    "lusca": "^1.7.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "nunjucks": "^3.2.3",
    "passport": "0.6.0",
    "pg": "^8.13.1",
    "role-acl": "^4.5.4",
    "sass": "^1.97.3",
    "semver": "^7.5.2",
    "setup": "^0.0.3",
    "uglify-js": "^3.15.4",
    "winston": "^3.3.3",
    "yarn": "^1.22.18"
