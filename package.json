    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-standard": "^5.0.0",
    "js-yaml": "^4.1.1",
    "jsdoc": "^4.0.5",
    "marked": "^4.0.15",
