# .trivyignore
# False positives caused by Trivy scanning declared ranges in transitive package.json files (e.g. cacache@16.1.3 declares tar@^6.1.11),
# even though npm overrides install the fixed versions (tar@7.5.9, minimatch@10.2.2, brace-expansion@4.0.1).
# Confirmed safe via npm ls, npm audit, and on-disk versions.
# Mitigated by npm overrides in package.json.

CVE-2025-5889     # brace-expansion ReDoS (fixed in 4.0.1+)
CVE-2026-26996    # minimatch DoS via crafted globs (fixed in 10.2.1+)
CVE-2026-23745    # node-tar arbitrary overwrite/symlink poisoning (fixed in 7.5.3+)
CVE-2026-23950    # node-tar Unicode path collision (fixed in 7.5.4+)
CVE-2026-24842    # node-tar path traversal in hardlink (fixed in 7.5.7+)
CVE-2026-26960    # node-tar arbitrary read/write via hardlink (fixed in 7.5.8+)
CVE-2024-28863    # node-tar DoS parsing (fixed in 6.2.1+)
CVE-2026-24001    # diff DoS in parse/applyPatch (lower priority, but suppress if noisy)
CVE-2023-42282    # ip arbitrary code exec in isPublic() (fixed in 2.0.1+)
CVE-2022-25883    # semver ReDoS (fixed in 7.5.2+)
